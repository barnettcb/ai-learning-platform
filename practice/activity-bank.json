[
  {
    "module": 1,
    "title": "Recognize AI strengths and limits",
    "intro": "For each scenario, identify what AI is doing, the main limitation or risk, and the human responsibility.",
    "repeat": {
      "items": [
        "Generate possible themes for a neighborhood event.",
        "Decide whether chest pain is caused by anxiety.",
        "Rewrite a long email so it is easier to understand.",
        "Confirm the filing deadline for a current government program."
      ],
      "fields": [
        {
          "key": "behavior",
          "label": "What AI is being asked to do",
          "type": "text",
          "required": true
        },
        {
          "key": "risk",
          "label": "Main limitation or risk",
          "type": "text",
          "required": true
        },
        {
          "key": "responsibility",
          "label": "Human responsibility",
          "type": "text",
          "required": true
        }
      ]
    }
  },
  {
    "module": 2,
    "title": "Interactive task worksheet",
    "intro": "Choose the safest action for four scenarios, explain why, and identify the next step.",
    "repeat": {
      "items": [
        "Create five names for a fictional character.",
        "Review a confidential employee investigation file in a personal AI account.",
        "Prepare questions for a doctor using a short, de-identified symptom summary.",
        "Compare vacation ideas using general preferences and a budget range."
      ],
      "fields": [
        {
          "key": "action",
          "label": "Action",
          "type": "select",
          "options": [
            "Choose one",
            "Use AI normally",
            "Use AI with safeguards",
            "Use another source first",
            "Do not use AI for this task"
          ],
          "required": true
        },
        {
          "key": "reason",
          "label": "Why this action fits",
          "type": "textarea",
          "required": true
        },
        {
          "key": "next",
          "label": "Safest next step",
          "type": "text",
          "required": true
        }
      ]
    }
  },
